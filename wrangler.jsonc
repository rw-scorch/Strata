{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strata",
  "main": "workers/index.ts",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "vars": {
    "STRIPE_PRICE_ID": "price_1Ug8PCAARygIHEjFEpARKYs8",
    "HOSTING_PRICE_ID": "price_1Ug8RyAARygIHEjFCEhLYNY5",
    "SHARD_PACKS": "[{\"price\":\"price_1UgePOAARygIHEjFPu3mpDa8\",\"shards\":500,\"label\":\"$1.99 USD\"},{\"price\":\"price_1UgePOAARygIHEjF1EycLU02\",\"shards\":1300,\"label\":\"$4.99 USD\"},{\"price\":\"price_1UgePPAARygIHEjFS8HMTNvR\",\"shards\":2800,\"label\":\"$9.99 USD\"}]"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORLD_ROOMS", "class_name": "WorldRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v3", "new_sqlite_classes": ["Registry"] }
  ]
}
