{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strata",
  "main": "workers/index.ts",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORLD_ROOMS", "class_name": "WorldRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v3", "new_sqlite_classes": ["Registry"] }
  ]
}
